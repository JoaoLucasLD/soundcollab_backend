generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String          @id @default(cuid())
  email                   String          @unique
  passwordHash            String
  tokenVersion            Int             @default(0)
  failedLoginAttempts     Int             @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  profile                 Profile?
  matchesAsUserA          Match[]         @relation("MatchUserA")
  matchesAsUserB          Match[]         @relation("MatchUserB")
  collaborationsRequested Collaboration[] @relation("CollaborationRequester")
  collaborationsReceived  Collaboration[] @relation("CollaborationReceiver")
  chatMessagesSent        ChatMessage[]
}

model Profile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  displayName        String
  city               String?
  gender             Gender?
  birthDateEncrypted String?
  experience         Int?
  preferences        String?
  bio                String?
  collaborationGoals CollaborationGoal[] @default([])
  availabilityPeriods AvailabilityPeriod[] @default([])
  availabilityTimes   AvailabilityTime[]   @default([])
  availabilityNotes   String?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  instruments        Instrument[]
  styles             Style[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model InstrumentCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  instruments Instrument[]
}

model Instrument {
  id         String             @id @default(cuid())
  name       String             @unique
  categoryId String
  category   InstrumentCategory @relation(fields: [categoryId], references: [id])
  profiles   Profile[]
}

model Style {
  id       String    @id @default(cuid())
  name     String    @unique
  profiles Profile[]
}

model Match {
  id             String          @id @default(cuid())
  userAId        String
  userBId        String
  score          Float
  status         MatchStatus     @default(PENDING)
  createdAt      DateTime        @default(now())
  userA          User            @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB          User            @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  collaborations Collaboration[]

  @@unique([userAId, userBId])
}

model Collaboration {
  id           String              @id @default(cuid())
  requesterId  String
  receiverId   String
  matchId      String?
  status       CollaborationStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  requester    User                @relation("CollaborationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver     User                @relation("CollaborationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  match        Match?              @relation(fields: [matchId], references: [id], onDelete: SetNull)
  conversation ChatConversation?
}

model ChatConversation {
  id              String        @id @default(cuid())
  collaborationId String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CollaborationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CollaborationGoal {
  BAND
  RECORDING
  LIVE_SHOWS
  COMPOSITION
  PRODUCTION
  STUDY
  CASUAL_JAM
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AvailabilityPeriod {
  WEEKDAYS
  WEEKENDS
}

enum AvailabilityTime {
  MORNING
  AFTERNOON
  EVENING
}
